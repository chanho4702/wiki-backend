{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/schemas/collaboration-ticket-v2.schema.json",
  "title": "Collaboration Ticket Payload v2",
  "description": "wiki-backend가 Redis에 TTL로 저장하고 collaboration service가 GETDEL로 소비하는 계약. v1에 발급 시점 page 버전(pageVersion)과 공동 초안 reset_epoch(draftEpoch, 행 없으면 0)을 더했다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pageId",
    "userId",
    "displayName",
    "room",
    "permission",
    "pageVersion",
    "draftEpoch",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "pageId": { "type": "integer", "minimum": 1 },
    "userId": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "room": { "type": "string", "pattern": "^page:[1-9][0-9]*$" },
    "permission": { "const": "EDIT" },
    "pageVersion": { "type": "integer", "minimum": 1 },
    "draftEpoch": { "type": "integer", "minimum": 0 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
